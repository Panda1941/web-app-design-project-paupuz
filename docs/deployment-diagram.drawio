        <!-- web service -->
        <mxCell id="webnode" value="&lt;b&gt;«container»&lt;/b&gt;&lt;br&gt;Paslauga web&lt;br&gt;lol-builds.up.railway.app" style="verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;shape=cube;size=10;direction=south;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
