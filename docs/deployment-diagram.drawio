        <mxCell id="dist" value="«artifact»&lt;br&gt;&lt;b&gt;frontend/dist&lt;/b&gt;&lt;br&gt;(sukompiliuota React aplikacija, paveikslėliai)" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#333333;" vertex="1" parent="1">
